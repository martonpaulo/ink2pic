{
  "name": "Ink2Pic",
  "version": "0.1.0",
  "description": "Write a word, get a picture.",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "validate": "npm run lint && npm run typecheck && npm test && npm run test:native && python3 scripts/text_check.py && python3 scripts/issue_links.py && python3 scripts/dry_check.py",
    "start": "react-native start",
    "icon": "node scripts/render-icon.cjs",
    "test:native": "node scripts/native-build.cjs --test",
    "build": "bash buildPlugin.sh && node scripts/native-build.cjs --package"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.79.2",
    "sn-plugin-lib": "0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
